# BananaVision Python FastAPI — Environment Variables
# Copy ke .env dan sesuaikan

# Tipe model default saat startup (mobilenetv2 atau resnet50)
MODEL_TYPE=mobilenetv2

# Railway Volume mount path for cached model files
MODEL_DIR=/data/models

# URL Node.js backend untuk auto-recovery model saat startup
# Local development: http://localhost:5000/api
# Railway: https://bananavisionv3-production-12ee.up.railway.app/api
NODE_BACKEND_URL=https://bananavisionv3-production-12ee.up.railway.app/api
MODEL_SYNC_TOKEN=<same-strong-secret-as-backend>
