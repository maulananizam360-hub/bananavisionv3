# BananaVision Backend — Environment Variables Example
# Copy ke .env dan isi nilainya

# === Server ===
PORT=5000
NODE_ENV=development  # atau production

# === Database (MongoDB Atlas atau MongoDB lokal) ===
DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/bananavision

# === Firebase Authentication ===
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@project.iam.gserviceaccount.com

# === JWT ===
JWT_SECRET=generate_strong_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# === CORS — Daftar origin yang diizinkan (pisahkan dengan koma) ===
# Development and Vercel production frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://bananavision.vercel.app

# === ML Server (Python FastAPI) ===
# Lokal dan server sama mesin: http://localhost:8000
ML_SERVER_URL=http://localhost:8000

# === Model Storage (Supabase Storage untuk service Railway terpisah) ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_BUCKET=models
MODEL_SYNC_TOKEN=<same-strong-secret-as-python-service>

# Opsional untuk penyimpanan disk lokal
# MODEL_STORAGE_PATH=/path/to/models

# === Proxy (aktifkan jika di belakang Nginx/load balancer) ===
TRUST_PROXY=1
